# `direnv` evaluates this file with bash, and there is no shebang to say so.
# shellcheck shell=bash

# The repository-local package directory that makes the working tree resolve
# as `@preview/animo:0.1.0`, so that every example imports the string a reader copies.
# The test suite does not rely on this: it exports the variable itself.
export TYPST_PACKAGE_PATH="${PWD}/.typst-packages"

# The browsers that the browser tier of the test suite drives.
# `setup.sh` downloads them here, so that removing `.venv/` undoes the whole bootstrap.
# The test suite exports this itself as well, for a contributor without `direnv`.
export PLAYWRIGHT_BROWSERS_PATH="${PWD}/.venv/playwright"

# Absent before the first `uv sync`, so that `direnv allow` works on a fresh clone.
if [ -f .venv/bin/activate ]; then
  # shellcheck source=/dev/null
  source .venv/bin/activate
fi
